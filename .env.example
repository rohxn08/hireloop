# Copy to .env (gitignored) and fill in. Real environment variables override these.
# The older WELLFOUND_* names still work.

# --- Email alert after each submitted application ---
# The Gmail address that receives the alerts.
HIRELOOP_EMAIL_TO=
# The account that sends them. Leave blank to send from HIRELOOP_EMAIL_TO to itself.
HIRELOOP_SMTP_USER=
# A Gmail APP PASSWORD for the sending account, not its normal password.
# Needs 2-Step Verification on, then: https://myaccount.google.com/apppasswords
HIRELOOP_SMTP_PASSWORD=

# --- Optional ---
# HIRELOOP_AUTO_APPLY=0
# HIRELOOP_INDEED_AUTO_APPLY=0     # Indeed also needs this before it sends without asking
# HIRELOOP_DAILY_START=5            # Wellfound cap: start
# HIRELOOP_DAILY_LIMIT=15           # Wellfound cap: max
# HIRELOOP_INDEED_DAILY_START=10    # Indeed cap: start
# HIRELOOP_INDEED_DAILY_LIMIT=30    # Indeed cap: max
# HIRELOOP_INDEED_URL=https://in.indeed.com
# HIRELOOP_HEADLESS=0
